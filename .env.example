# Скопируйте в .env и заполните. .env в git не попадает.

# Qdrant. В docker-compose адрес переопределяется на http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=study_materials_v1

# Эмбеддинги: BAAI/bge-m3 (по умолчанию) или intfloat/multilingual-e5-base
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# Чанкинг, токены
CHUNK_TOKENS=500
CHUNK_OVERLAP=60

# Поиск
TOP_K=5
MIN_SCORE=0.0

# LLM — любой OpenAI-совместимый API.
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:3b  (ключ не нужен)
# vLLM:    LLM_BASE_URL=http://localhost:8000/v1   LLM_MODEL=<имя модели>
LLM_BASE_URL=https://api.apinex.bond/v1
LLM_API_KEY=
LLM_MODEL=free/glm-5.3-flash
LLM_TIMEOUT=60
LLM_MAX_TOKENS=2048
