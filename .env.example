# Скопируйте в .env и заполните. .env в git не попадает.

# Qdrant. В docker-compose адрес переопределяется на http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=study_materials_v2

# Эмбеддинги: BAAI/bge-m3 (по умолчанию) или intfloat/multilingual-e5-base
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# Чанкинг: structured (по разделам) или simple (окно внутри страницы), размеры в токенах
CHUNKING=structured
CHUNK_TOKENS=500
CHUNK_OVERLAP=60
CHUNK_MIN_TOKENS=60

# Поиск: hybrid (dense + BM25 через RRF) или dense; реранкер bge-reranker-v2-m3
RETRIEVAL_MODE=hybrid
TOP_K=5
RERANK_ENABLED=true
RERANK_CANDIDATES=10
# Скор реранкера: выше — ответ есть, ниже floor — точно нет, между — спрашиваем LLM
RELEVANCE_THRESHOLD=0.5
RELEVANCE_FLOOR=0.05

# Граф
MAX_REWRITES=2
SUMMARY_TRIGGER_TOKENS=3000

# LLM — любой OpenAI-совместимый API.
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b  (ключ не нужен)
# vLLM:    LLM_BASE_URL=http://localhost:8000/v1   LLM_MODEL=<имя модели>
LLM_BASE_URL=https://api.apinex.bond/v1
LLM_API_KEY=
LLM_MODEL=free/glm-5.3-flash
# Запасные модели у того же провайдера и запасной провайдер целиком
LLM_FALLBACK_MODELS=free/gpt-6-luna
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT=60
LLM_MAX_TOKENS=2048

# GigaChat (Сбер) — отдельный адаптер: OAuth-токен на 30 минут обновляет SDK.
# Ключ авторизации из личного кабинета developers.sber.ru (base64 от client_id:client_secret).
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
# Сертификаты подписаны корнем Минцифры; файл в репозитории, путь — от корня проекта
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.pem
GIGACHAT_VERIFY_SSL=true

# Порядок провайдеров: openai (LLM_* + LLM_FALLBACK_MODELS), gigachat, fallback
LLM_CHAIN=gigachat,openai

# Адрес API для интерфейса и для ссылок в цитатах
API_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000
